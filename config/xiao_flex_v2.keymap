#include <dt-bindings/led/led.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        backspace_del: backspace_del {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings =
                <&msc SCRL_UP>,
                <&msc SCRL_DOWN>,
                <&msc SCRL_LEFT>,
                <&msc SCRL_RIGHT>;
        };

        ltm: layer-tap-or-mouse {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        lhm: layer-tap-hold-or-mouse {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            hold-while-undecided;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&mkp>;
        };

        mto: momentary-and-toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            hold-while-undecided;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
        };

        mok: momentary-and-keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            hold-while-undecided;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        voldown {
            bindings = <&kp C_VOL_DN>;
            key-positions = <54 10>;
            layers = <0>;
        };

        volup {
            bindings = <&kp C_VOL_UP>;
            key-positions = <56 10>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt GRAVE ESC         &kp N1  &kp N2  &mt C_AC_DESKTOP_SHOW_ALL_WINDOWS N3  &kp N4     &kp N5           &kp N6          &kp N7          &kp N8           &kp N9   &kp N0    &mt EQUAL MINUS
&kp TAB               &kp Q   &kp W   &kp E                                 &kp R      &kp T            &kp Y           &kp U           &kp I            &kp O    &kp P     &mt RIGHT_BRACKET LEFT_BRACKET
&mto 3 4              &kp A   &kp S   &kp D                                 &kp F      &kp G            &kp H           &kp J           &kp K            &kp L    &kp SEMI  &kp SQT
&mt LEFT_SHIFT LCAPS  &kp Z   &kp X   &kp C                                 &kp V      &kp B            &kp N           &kp M           &kp COMMA        &kp DOT  &kp FSLH  &kp BSLH
                                      &mo 1                                 &kp SPACE  &kp BACKSPACE    &kp DEL         &kp RET         &kp UP_ARROW
                                      &kp LCTRL                             &kp LALT   &kp LEFT_GUI     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp F1  &kp F2      &kp F3            &trans        &trans          &mkp LCLK  &mkp RCLK  &mkp MCLK       &kp N8     &kp N9  &kp BSPC
&trans  &trans  &caps_word  &kp END           &trans        &trans          &trans     &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp N6  &kp MINUS
&trans  &trans  &mkp LCLK   &mkp RCLK         &trans        &trans          &kp HOME   &kp TAB    &kp N1          &kp N2     &kp N3  &kp PLUS
&trans  &trans  &trans      &kp C             &kp V         &trans          &trans     &trans     &bl BL_OFF      &trans     &trans  &trans
                            &to 0             &trans        &trans          &kp DEL    &trans     &trans
                            &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI    &trans     &trans     &to 2
            >;
        };

        layer_2 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &trans        &trans          &trans  &trans          &kp UP_ARROW    &trans           &trans  &bt BT_CLR
&trans  &trans        &trans        &trans            &trans        &trans          &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans        &trans        &trans            &trans        &trans          &trans  &trans          &kp UP          &trans           &trans  &trans
&trans  &trans        &trans        &kp C             &kp V         &trans          &trans  &kp LEFT        &kp DOWN        &kp RIGHT        &trans  &trans
                                    &to 0             &trans        &trans          &trans  &trans          &trans
                                    &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI    &trans  &trans          &trans
            >;
        };

        scroll_tap_layer {
            bindings = <
&trans  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &trans  &trans  &trans    &trans  &kp C_RW  &kp C_PP  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_UP
&trans  &trans              &trans               &trans  &trans  &trans    &trans  &trans    &trans    &trans      &trans      &kp C_VOL_DN
&trans  &trans              &trans               &trans  &trans  &trans    &trans  &trans    &trans    &trans      &trans      &trans
&trans  &trans              &trans               &trans  &trans  &trans    &trans  &trans    &trans    &trans      &trans      &trans
                                                 &to 0   &trans  &trans    &trans  &trans    &trans
                                                 &trans  &trans  &trans    &trans  &trans    &trans
            >;

            label = "scroll_tap";
            sensor-bindings = <&scroll_encoder>;
        };

        SNIPE_LAYER {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&to 0   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &mo 1   &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
